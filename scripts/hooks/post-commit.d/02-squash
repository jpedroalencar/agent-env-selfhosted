#!/usr/bin/env bash
# ============================================================
# 02-squash — Consolidate sprint commits after commit
# ============================================================
# Runs after every commit (post-commit hook framework).
# If we're on a sprint/* branch with more than one commit ahead
# of origin/main, consolidate into a single clean commit via
# scripts/sprint-finalize.sh (which force-pushes the result).
#
# Guards:
#   - Only on sprint/* branches (not main, not detached HEAD).
#   - Skips if a Draft PR for this branch is already open, so we
#     never force-push over a branch you're actively reviewing.
#   - Skips if nothing to consolidate (<=1 commit ahead).
#
# Non-blocking: any failure is reported but does not roll back
# the commit (per post-commit hook contract).
# ============================================================

set -uo pipefail

BRANCH=$(git symbolic-ref --short HEAD 2>/dev/null || echo "")
[ -z "$BRANCH" ] && exit 0
[[ "$BRANCH" == main ]] && exit 0
[[ ! "$BRANCH" =~ ^sprint/ ]] && exit 0

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || echo "")"
[ -z "$REPO_ROOT" ] && exit 0
SCRIPT="$REPO_ROOT/scripts/sprint-finalize.sh"
[ -x "$SCRIPT" ] || { echo "  [squash] sprint-finalize.sh not found — skipping"; exit 0; }

# Skip if a PR for this branch is already open (don't force-push mid-review)
if command -v gh >/dev/null 2>&1; then
  OPEN_PR=$(gh pr list --head "$BRANCH" --state open --json number --jq '.[0].number' 2>/dev/null || echo "")
  if [ -n "$OPEN_PR" ]; then
    echo "  [squash] PR #$OPEN_PR already open for $BRANCH — skipping (review in progress)"
    exit 0
  fi
fi

AHEAD=$(git rev-list --count origin/main..HEAD 2>/dev/null || echo 0)
[ "$AHEAD" -gt 1 ] || { echo "  [squash] $AHEAD commit(s) ahead — nothing to consolidate"; exit 0; }

# Rebase onto main so sprint-finalize.sh's behind-guard passes
if [ "$(git rev-list --count HEAD..origin/main 2>/dev/null || echo 0)" -gt 0 ]; then
  echo "  [squash] rebasing onto origin/main..."
  git pull --rebase origin main 2>/dev/null || {
    echo "  [squash] rebase failed (conflict) — skipping consolidation"
    exit 0
  }
fi

echo "  [squash] $AHEAD commits ahead on $BRANCH — consolidating..."
if "$SCRIPT"; then
  echo "  [squash] consolidated successfully"
else
  echo "  [squash] consolidation failed (non-blocking) — branch left as-is"
fi
exit 0
